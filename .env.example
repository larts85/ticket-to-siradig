VITE_WEB_HOSTNAME=localhost:8081
ZERO_UPSTREAM_DB=postgresql://postgres:postgres@localhost:5432/postgres
ZERO_CVR_DB=postgresql://postgres:postgres@localhost:5432/zero_cvr
